    <org.eventb.core.axiom name="4" org.eventb.core.label="axm2" org.eventb.core.predicate="plan1 ={triggering_event_P1, context_P1, plan_body_P1, success_condition_P1, failure_condition_P1, procedural_program_P1 ·&#10;                     triggering_event_P1 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P1 = start ↦ waste&#10;                 ∧ context_P1 = TruthFormula&#10;                 ∧ success_condition_P1 = Conjunctive_formula(&#10;                                                                  Conjunctive_formula(&#10;                                                                          Negated_formula(Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ a))),&#10;                                                                          Negated_formula(Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ b)))&#10;                                                                                                             ),&#10;                                                                   Negated_formula(Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ c)))&#10;                                                                                                         )&#10;                 ∧ procedural_program_P1 ∈ Event_predicate_symbols × Terms&#10;                 ∧ procedural_program_P1 = clean_operation ↦ waste &#10;                 ∧ failure_condition_P1 = FalseFormula&#10;                 ∧ plan_body_P1 = Declarative_goal_user(success_condition_P1, procedural_program_P1, failure_condition_P1)&#10;                 ∣ triggering_event_P1 ↦ (context_P1 ↦ plan_body_P1)&#10;                }                                                                   "/>
