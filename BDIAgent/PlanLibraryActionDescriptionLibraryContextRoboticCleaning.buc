    <org.eventb.core.axiom name="6" org.eventb.core.label="axm4" org.eventb.core.predicate="plan3 ={X, Y, Z, triggering_event_P3, context_P3, plan_body_P3·&#10;                 X ∈ PointTerms&#10;                 ∧ Y ∈ PointTerms&#10;                 ∧ Z ∈ PointTerms&#10;                 ∧ triggering_event_P3 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P3 = collect ↦ TwoAryVectorFunction(waste ↦X)&#10;                 ∧ context_P3 = Conjunctive_formula(&#10;                                                                          Belief_atom(location ↦ TwoAryVectorFunction(robot ↦ Y)),&#10;                                                                          Belief_atom(adjacent↦ TwoAryVectorFunction(Y ↦ Z))&#10;                                                                                     )&#10;                 ∧ plan_body_P3 = Sequence_user(BasicP_event_user(locate ↦ TwoAryVectorFunction(robot ↦ Z)), BasicP_action_user(pick ↦ X))&#10;                 ∣ triggering_event_P3 ↦ (context_P3 ↦ plan_body_P3)&#10;                }   "/>
    <org.eventb.core.axiom name="7" org.eventb.core.label="axm5" org.eventb.core.predicate=" plan4 ={X, triggering_event_P4, context_P4, plan_body_P4 ·&#10;                 X ∈ PointTerms&#10;                 ∧ triggering_event_P4 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P4 = locate ↦ TwoAryVectorFunction(robot ↦ X)&#10;                 ∧ context_P4 = Belief_atom(location ↦ TwoAryVectorFunction(robot ↦ X))&#10;                 ∧ plan_body_P4 = BasicP_action_user(stop ↦ robot)&#10;                 ∣ triggering_event_P4 ↦ (context_P4 ↦ plan_body_P4)&#10;                }         "/>
