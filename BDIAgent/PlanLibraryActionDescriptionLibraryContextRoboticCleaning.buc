    <org.eventb.core.axiom name="2" org.eventb.core.comment=" " org.eventb.core.label="axm1" org.eventb.core.predicate="plan_library = plan1 ∪ plan2 ∪ plan3 ∪ plan4 ∪ plan5  "/>
    <org.eventb.core.axiom name="4" org.eventb.core.label="axm2" org.eventb.core.predicate="plan1 ={triggering_event_P1, context_P1, plan_body_P1, success_condition_P1, failure_condition_P1, procedural_program_P1 ·&#10;                     triggering_event_P1 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P1 = start ↦ waste&#10;                 ∧ context_P1 = TruthFormula&#10;                 ∧ success_condition_P1 = Conjunctive_formula(&#10;                                                                  Conjunctive_formula(&#10;                                                                          Negated_formula(Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ a))),&#10;                                                                          Negated_formula(Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ b)))&#10;                                                                                                             ),&#10;                                                                   Negated_formula(Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ c)))&#10;                                                                                                         )&#10;                 ∧ procedural_program_P1 ∈ Event_predicate_symbols × Terms&#10;                 ∧ procedural_program_P1 = clean_operation ↦ waste &#10;                 ∧ failure_condition_P1 = FalseFormula&#10;                 ∧ plan_body_P1 = Declarative_goal_user(success_condition_P1, procedural_program_P1, failure_condition_P1)&#10;                 ∣ triggering_event_P1 ↦ (context_P1 ↦ plan_body_P1)&#10;                }                                                                   "/>
    <org.eventb.core.axiom name="5" org.eventb.core.comment="            " org.eventb.core.label="axm3" org.eventb.core.predicate="plan2 ={X, triggering_event_P2, context_P2, plan_body_P2·&#10;                 X ∈ PointTerms&#10;                 ∧ triggering_event_P2 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P2 = clean_operation ↦ waste&#10;                 ∧ context_P2 = Belief_atom(location ↦ TwoAryVectorFunction(waste ↦ X))&#10;                 ∧ plan_body_P2 = BasicP_event_user(collect ↦ TwoAryVectorFunction(waste ↦ X))&#10;                 ∣ triggering_event_P2 ↦ (context_P2 ↦ plan_body_P2)&#10;                }                                         "/>
    <org.eventb.core.axiom name="6" org.eventb.core.label="axm4" org.eventb.core.predicate="plan3 ={X, Y, Z, triggering_event_P3, context_P3, plan_body_P3·&#10;                 X ∈ PointTerms&#10;                 ∧ Y ∈ PointTerms&#10;                 ∧ Z ∈ PointTerms&#10;                 ∧ triggering_event_P3 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P3 = collect ↦ TwoAryVectorFunction(waste ↦X)&#10;                 ∧ context_P3 = Conjunctive_formula(&#10;                                                                          Belief_atom(location ↦ TwoAryVectorFunction(robot ↦ Y)),&#10;                                                                          Belief_atom(adjacent↦ TwoAryVectorFunction(Y ↦ Z))&#10;                                                                                     )&#10;                 ∧ plan_body_P3 = Sequence_user(BasicP_event_user(locate ↦ TwoAryVectorFunction(robot ↦ Z)), BasicP_action_user(pick ↦ X))&#10;                 ∣ triggering_event_P3 ↦ (context_P3 ↦ plan_body_P3)&#10;                }   "/>
    <org.eventb.core.axiom name="7" org.eventb.core.label="axm5" org.eventb.core.predicate=" plan4 ={X, triggering_event_P4, context_P4, plan_body_P4 ·&#10;                 X ∈ PointTerms&#10;                 ∧ triggering_event_P4 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P4 = locate ↦ TwoAryVectorFunction(robot ↦ X)&#10;                 ∧ context_P4 = Belief_atom(location ↦ TwoAryVectorFunction(robot ↦ X))&#10;                 ∧ plan_body_P4 = BasicP_action_user(stop ↦ robot)&#10;                 ∣ triggering_event_P4 ↦ (context_P4 ↦ plan_body_P4)&#10;                }         "/>
    <org.eventb.core.axiom name="8" org.eventb.core.label="axm6" org.eventb.core.predicate="plan5 ={X, Y, Z, triggering_event_P5, context_P5, plan_body_P5 ·&#10;                 X ∈ PointTerms&#10;                 ∧ Y ∈ PointTerms&#10;                 ∧ Z ∈ PointTerms&#10;                 ∧ triggering_event_P5 ∈ Event_predicate_symbols × Terms&#10;                 ∧ triggering_event_P5 = locate ↦ TwoAryVectorFunction(robot ↦X)&#10;                 ∧ context_P5 = Conjunctive_formula(&#10;                                                                          Belief_atom(location ↦ TwoAryVectorFunction(robot ↦ Y)),&#10;                                                                          Belief_atom(adjacent↦ TwoAryVectorFunction(Y ↦ Z))&#10;                                                                                     )&#10;                 ∧ plan_body_P5 = Sequence_user(BasicP_action_user(move ↦ TwoAryVectorFunction(Y ↦ Z)), BasicP_event_user(locate ↦ TwoAryVectorFunction(robot ↦X)))&#10;                 ∣ triggering_event_P5 ↦ (context_P5 ↦ plan_body_P5)&#10;                }   "/>
