                    <org.eventb.theory.core.scRecursiveDefinitionCase name="(" org.eventb.core.expression="BasicP_action_intention(act) ⦂ IntentionP(Belief_predicate_symbols,Event_predicate_symbols,Action_predicate_symbols,Terms)" org.eventb.core.source="/AgentProgramConstructorsOperators/AgentProgramConstructorandSemanticOperators.tuf|org.eventb.theory.core.theoryRoot#AgentProgramConstructorandSemanticOperators|org.eventb.theory.core.newOperatorDefinition#element2|org.eventb.theory.core.recursiveOperatorDefinition#*|org.eventb.theory.core.recursiveDefinitionCase#(" org.eventb.theory.core.formula="{context⦂BeliefFormula(Belief_predicate_symbols,Terms),deletset⦂ℙ(Belief_predicate_symbols×Terms),addset⦂ℙ(Belief_predicate_symbols×Terms)·context ↦ (deletset ↦ addset)∈action_library[{act}]∧belief_entail(current_belief_base,context) ∣ (Nil ⦂ IntentionP(Belief_predicate_symbols,Event_predicate_symbols,Action_predicate_symbols,Terms)) ↦ (current_belief_base ∖ deletset)∪addset}"/>
